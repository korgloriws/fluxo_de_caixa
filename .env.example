# Copie para .env e preencha com valores reais (o arquivo .env NÃO vai para o Git):
#   cp .env.example .env
#
# NÃO defina DATA_DIR/UPLOADS_DIR/EXPORTS_DIR como /app/... no Windows.
# No Docker isso já é definido pelo docker-compose.yml.

APP_PORT=3070
# Na VM (atrás do nginx): APP_BIND=127.0.0.1 e APP_PORT=8002
# APP_BIND=127.0.0.1

# Prefixo público no nginx. Vazio na VPS (acesso por porta).
# Na VM: ROOT_PATH=/fluxo-de-caixa
ROOT_PATH=

ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# Gere um valor longo e aleatório, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- API Extratos Banco do Brasil ---
# sandbox = JSON local | producao = API real (datas vêm do filtro da tela)
BB_MODO=producao
# producao | homologacao
BB_AMBIENTE=producao

# A App Key vai na query: ?gw-dev-app-key=...
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_APP_KEY=
# A API Extratos NÃO lista contas. Cadastre todas aqui (SEM dígito verificador).
# Uma conta:
BB_AGENCIA=
BB_CONTA=
# Várias contas (recomendado para o filtro "Conta" na tela):
# BB_CONTAS=1633:73015,1633:outra,4321:98765
# Se BB_CONTAS estiver preenchido, ele prevalece sobre BB_AGENCIA/BB_CONTA.

# Certificado cliente mTLS (obrigatório no host extratos.mtls.*)
# Aceita .pfx/.p12 (A1) ou .pem
# Ex.: BB_CERT_FILE=app/certificado/MUNICIPIO....pfx
BB_CERT_FILE=
# Se a senha tiver #, espaços ou caracteres especiais, use aspas:
# BB_CERT_PASSWORD="minha#senha"
BB_CERT_PASSWORD=
# BB_KEY_FILE=  # só se usar .pem com chave separada

# Opcional (sobrescreve URLs do BB_AMBIENTE):
# BB_TOKEN_URL=https://oauth.bb.com.br/oauth/token
# BB_EXTRATO_BASE_URL=https://extratos.mtls.api.bb.com.br/v2
# BB_SCOPE=extrato-info

# --- SGP (sistema financeiro da prefeitura / SOAP) ---
# WSDL padrão Contagem (pode sobrescrever):
# SGP_WSDL_URL=http://pm-contagem.sgpcloud.com.br/sgp/webservice/portal/wsdl
SGP_WSDL_URL=
# Basic Auth (se o portal exigir):
SGP_USERNAME=
SGP_PASSWORD=

