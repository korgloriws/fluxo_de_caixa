# Copie para .env e preencha com valores reais (o arquivo .env NÃO vai para o Git):
#   cp .env.example .env

# Porta publicada na VPS
APP_PORT=3070

# Administrador criado apenas na primeira execução (banco vazio)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# Gere um valor longo e aleatório, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Diretórios dentro do container (compose já monta volumes locais)
DATA_DIR=/app/data
UPLOADS_DIR=/app/uploads
EXPORTS_DIR=/app/exports
